@{
    string name = "John";
    var person = new Person() { Name = name, DateOfBirth = Convert.ToDateTime("2000-01-05"), Gender = Person.Genders.Male};
    string alertMessage = $"<script>alert('Hello {name}!');</script>";    
}

<!DOCTYPE html>

<html>
<head>
    <title>Hello View</title>
    <meta charset="utf-8"/>
</head>
<body>
<div>
    Hello @person.Name
</div>
@{
    var dateOfBirth = person.DateOfBirth;
}
<h2>@dateOfBirth</h2> @* 先替换成<h2>2000/1/5 0:00:00</h2>,再给浏览器渲染.浏览器只看到纯html *@
@Html.Raw(alertMessage)
@switch (person.Gender)
{
    case Person.Genders.Male:
        <p>November 19 is International Men's Day</p>
        break;
    case Person.Genders.Female:
        <p>March 8 is International Women's Day</p>
        break;
    default:
        <p>March 31 is International Transgender's Day</p>
        break;
}
</body>
</html>